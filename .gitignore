# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Analysis outputs (generated by analysis scripts; not committed)
analysis/output/

# AFL++ raw output directories inside results/
# These are large and can be regenerated by re-running trials.
# We keep the extracted telemetry (fuzzer_stats, plot_data, tte.txt,
# crashing_input) but not the full AFL++ working directories.
results/*/*/trial-*/afl-out/

# Nyx share directories (generated locally; far too large to commit)
# These live in $HOME, not inside smite-evaluation/, so this is
# precautionary in case someone creates them here accidentally.
smite-nyx-*/

# Docker build artifacts
docker/.docker-build-cache/

# Temporary files
*.tmp
*.bak
*.orig
*.swp
*.swo
*~

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor directories
.vscode/
.idea/
*.iml
*.iws

# Virtual environments (if someone runs analysis locally)
.venv/
venv/
env/

# Jupyter (if analysis notebooks are added later)
.ipynb_checkpoints/
*.ipynb

# Compiled artifact (the appendix PDF is committed; intermediate LaTeX is not)
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.synctex.gz

# The following are intentionally NOT ignored and must be committed:
# results/trials.csv              — primary data file
# results/*/trial-*/tte.txt       — per-trial outcome
# results/*/trial-*/fuzzer_stats  — per-trial telemetry snapshot
# results/*/trial-*/plot_data     — per-trial coverage time series
# results/*/trial-*/crashing_input — crashing input for found bugs
# bugs/*/flag.patch    — bug instrumentation patches
# bugs/*/poc.input     — proof-of-concept inputs
# bugs/*/metadata.json — bug registry
# seeds/                          — fixed seed corpora
# docs/artifact-appendix.pdf      — compiled artifact appendix
